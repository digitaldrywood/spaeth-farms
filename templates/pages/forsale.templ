package pages

import (
	"spaeth-farms/pkg/meta"
	"spaeth-farms/templates/layouts"
)

type EmbryoPackage struct {
	Name         string
	Registration string
	Image        string
	Sires        []string
}

type Cow struct {
	Name         string
	Registration string
	Image        string
	AISire       string
	BreedingDate string
	CalvingDate  string
	RecentCalf   string
	EPDLink      string
}

type BredHeifer struct {
	Name         string
	Registration string
	Image        string
	CalvingDate  string
	Sire         string
	EPDLink      string
}

type Bull struct {
	Name      string
	BirthDate string
	Image     string
	EPDLink   string
}

